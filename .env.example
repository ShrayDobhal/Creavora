# Required in production. Generate distinct 32-byte-or-longer random values.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Application database for local development. Never copy a production URL here before running `npm run db:seed`.
DATABASE_URL=postgresql://creavora:creavora@localhost:5432/creavora_dev?schema=public

# Required explicit opt-in for `npm run db:seed`. This must be a separate local PostgreSQL URL;
# the seed command rejects NODE_ENV=production, non-local hosts, and missing confirmation.
SEED_DATABASE_URL=postgresql://creavora:creavora@localhost:5432/creavora_seed?schema=public
SEED_DEVELOPMENT_CONFIRMATION=

# Optional local-only override for the seeded test-account password (default: Test1234).
SEED_PASSWORD=Test1234

# Public application origin, for CORS and redirects.
NEXT_PUBLIC_APP_URL=https://your-domain.example

# Configure when Razorpay payments are enabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudflare R2 image uploads. The public base URL must not end with a slash.
# Browser uploads must allow the signed content-type and if-none-match request headers in bucket CORS.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
